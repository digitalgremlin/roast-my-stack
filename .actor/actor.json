{
  "actorSpecification": 1,
  "name": "roast-my-stack",
  "title": "Roast My Stack",
  "description": "Paste a URL and get a grounded tech-stack roast from Dr. Gordon Pelican.",
  "version": "0.1",
  "build": {
    "dockerfile": "./Dockerfile"
  },
  "input": {
    "title": "Roast My Stack",
    "description": "No input is required. Open the Actor's web endpoint.",
    "type": "object",
    "schemaVersion": 1,
    "properties": {}
  },
  "environmentVariables": {
    "OPENAI_API_KEY": "@OPENAI_API_KEY",
    "ROAST_MODEL": "gpt-5.6"
  },
  "webServerSchema": {
    "openapi": "3.0.3",
    "info": {
      "title": "Roast My Stack API",
      "version": "0.1.0"
    },
    "paths": {
      "/health": {
        "get": {
          "summary": "Health check",
          "responses": {
            "200": {
              "description": "Actor is healthy"
            }
          }
        }
      },
      "/roast": {
        "post": {
          "summary": "Detect and roast a website's technology stack",
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["url"],
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri"
                    }
                  }
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Grounded Dr. Pelican roast"
            },
            "400": {
              "description": "Invalid URL"
            }
          }
        }
      }
    }
  },
  "usesStandbyMode": true
}
